# Copy file này thành .env (chỉ dùng khi chạy local) — KHÔNG commit .env thật.
# Tất cả các biến đều TÙY CHỌN: không có thì game vẫn chạy đủ tính năng ở chế độ local.

# Địa chỉ API kết quả trận (Render Web Service nam-vs-nu-live-api), ví dụ:
# VITE_API_URL=https://nam-vs-nu-live-api.onrender.com
VITE_API_URL=

# Supabase (bảng xếp hạng): chỉ đọc từ env, không hardcode key ở đây.
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
